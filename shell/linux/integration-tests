#!/usr/bin/env bash
#
# integration-tests -- run the things unit checks cannot.
#
#   RUN:    shell/linux/integration-tests
#           shell/linux/integration-tests --fast     (only what needs no ROM)
#           shell/linux/integration-tests --list
#   PASS:   exit 0, and every case prints "ok".
#   FAIL:   exit 1, naming the case and what it saw.
#   SKIP:   exit 2. A skipped case is NOT a pass and does not exit 0, because
#           a suite that goes green when its prerequisites are missing is
#           reporting on the machine rather than on the code.
#
#   FLYCAST_ROM=/path/to.chd   the game to boot (default: first .chd under
#                              ~/ROMs/dc). Needed by everything except --fast.
#   FLYCAST_BIN=/path/to/bin   default: artifact/bin/flycast-dojo
#
# WHY THIS EXISTS
#
# The conformance suite checks the interface's contract. It cannot check that
# the emulator boots, that a script loads once the launcher rather than a
# terminal starts it, or that the video file has pictures in it. Every one of
# those has been broken on this branch, and every one was caught by a person
# looking at something rather than by a test:
#
#   [MEASURED 2026-08-09] a well-formed 8.7-second AVI, correct dimensions,
#   frame count, duration and container - entirely black. Every structural
#   check passed. Only decoding a frame and LOOKING at it found the bug.
#
#   [MEASURED 2026-09-04] a script that loaded nothing and reported nothing,
#   because dofile resolved against the working directory and the launcher
#   never sets one.
#
#   [MEASURED 2026-09-05] the first fresh clone of the emuapi package could not
#   run its own suite: the runner assumed the checkout was NAMED emuapi. The
#   in-tree copy had passed all day.
#
# So the cases below decode pixels, run from a directory with a deliberately
# wrong name, and start the emulator the way a desktop menu does - from a
# working directory that has nothing to do with the config.
#
# ON EXIT CODES: every emulator run captures its status directly, never through
# a pipe. `cmd | tail` reports tail's status, which once made five failing
# cases all print exit=0.

set -uo pipefail

SELF="$(realpath "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$(dirname "$SELF")")")"
BIN="${FLYCAST_BIN:-$ROOT/artifact/bin/flycast-dojo}"
PKG="$ROOT/emuapi"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/flycast-it.XXXXXX")"
DISPLAY_NUM=71
BOOT_SECONDS="${FLYCAST_BOOT_SECONDS:-22}"

pass=0; fail=0; skipped=0
declare -a failures=()

ok()   { pass=$((pass+1));    printf '  ok    %s\n' "$1"; }
bad()  { fail=$((fail+1));    failures+=("$1: $2"); printf '  FAIL  %s\n        %s\n' "$1" "$2"; }
skip() { skipped=$((skipped+1)); printf '  skip  %s\n        %s\n' "$1" "$2"; }

# Kill only what this run started. `pkill -x flycast-dojo` reached the
# developer's own emulator; the Xvfb pattern is anchored to THIS display number
# so it cannot match the session's own server.
XVFB_PID=""
cleanup() {
    [ -s "$WORK/pid" ] && kill -KILL "$(cat "$WORK/pid")" 2>/dev/null
    [ -n "$XVFB_PID" ] && kill -KILL "$XVFB_PID" 2>/dev/null   # its own display, by pid
    [ -n "${KEEP_WORK:-}" ] || rm -rf "$WORK"
}
trap cleanup EXIT

find_rom() {
    if [ -n "${FLYCAST_ROM:-}" ]; then printf '%s\n' "$FLYCAST_ROM"; return; fi
    find "$HOME/ROMs/dc" -maxdepth 1 -name '*.chd' 2>/dev/null | sort | head -1
}

start_x() {
    local geom="${1:-800x600x24}"
    # BY PID, NOT BY PATTERN. `[MEASURED 2026-09-14]` the cleanup here was
    # `pkill -f "^/usr/bin/Xvfb :71\b"`, and the process's argv[0] is `Xvfb`,
    # not the absolute path - the anchored pattern matched NOTHING, ever. One
    # Xvfb :71 survived every suite run (found at 641 s, ppid 1, after a green
    # run). The same class as the wrong-pid subshell capture fixed above: a
    # name-based kill does not fail loudly, it fails by leaving the process.
    #
    # START ONCE, KEEP IT. `[MEASURED 2026-09-14]` the first pid-based version
    # killed the previous server and respawned on the same display at once, and
    # the kernel had not always released the old socket: the new Xvfb could
    # not bind, xdpyinfo never answered, and a case SKIPPED - a different case
    # each run. (The pattern-based cleanup it replaced never killed anything,
    # which is why every case had quietly reused the first server for months.)
    # A server we started that still answers is the server; spawn only when
    # there is none.
    if [ -n "${XVFB_PID:-}" ] && kill -0 "$XVFB_PID" 2>/dev/null \
            && DISPLAY=":$DISPLAY_NUM" xdpyinfo >/dev/null 2>&1; then
        return 0
    fi
    [ -n "${XVFB_PID:-}" ] && { kill -KILL "$XVFB_PID" 2>/dev/null; sleep 1; }
    rm -f "/tmp/.X$DISPLAY_NUM-lock"
    Xvfb ":$DISPLAY_NUM" -screen 0 "$geom" >/dev/null 2>&1 &
    XVFB_PID=$!
    local i
    for i in $(seq 1 40); do
        DISPLAY=":$DISPLAY_NUM" xdpyinfo >/dev/null 2>&1 && return 0
        sleep 0.25
    done
    return 1
}

# Boot the emulator from a working directory that is NOT the config directory,
# which is how a desktop launcher starts it and how the path bug hid.
#
# `[MEASURED 2026-09-14]` THIS FUNCTION SET FLYCAST_ROOT, WHICH THE EMULATOR HAS
# NEVER READ. Nothing in the tree reads it: `core/linux-dist/main.cpp`'s
# find_user_config_dir/find_user_data_dir consult XDG_CONFIG_HOME and
# XDG_DATA_HOME, and `core/oslib/storage.cpp` additionally knows FLYCAST_HOME.
# A grep for FLYCAST_ROOT finds only the two shell scripts that SET it.
#
# Two consequences, and the second is much worse than the first:
#
#   1. Cases 3, 4 and 5 wrote their flycast.lua into a scratch root the
#      emulator never looked at, so it loaded no script, wrote no log there,
#      and all three failed with "no ... was written". They could not pass.
#   2. THE ISOLATION WAS DECORATIVE. Every run wrote into the developer's real
#      ~/.config/flycast-dojo and ~/.local/share/flycast-dojo. CLAUDE.md's
#      "automated testing must not touch the real desktop" was being violated
#      by the harness that is supposed to model good practice, and the
#      violation was invisible precisely BECAUSE the cases failed for an
#      unrelated-looking reason.
#
# The root passed in is now the flycast config directory itself, so its
# basename must be flycast-dojo - that is the subdirectory name both XDG
# lookups append. Asserted rather than assumed, because getting it wrong
# silently restores behaviour 2.
run_emulator() {
    local root="$1" seconds="$2" log="$3" marker="${4:-}"
    [ "$(basename "$root")" = "flycast-dojo" ] || {
        printf 'run_emulator: root must end in /flycast-dojo, got %s\n' "$root" >&2
        return 1
    }
    local xdg; xdg="$(dirname "$root")"
    mkdir -p "$xdg/data" "$xdg/home"

    # `env -C`, NOT `( cd / && ... & echo $! )`. `[MEASURED 2026-09-14]` the
    # subshell form captures THE SUBSHELL'S PID, not the emulator's - bash forks
    # for the `cd / && ...` list and does not exec-optimise it away:
    #
    #   ( cd / && sleep 40 & echo $! )  -> captured=3973611 actual=3973612
    #   env -C / sleep 41 &  echo $!    -> captured=3973614 actual=3973614
    #
    # Every kill -TERM therefore hit a subshell that had already exited, the
    # wait loop saw it gone within half a second and reported a clean exit, and
    # THE EMULATOR WAS NEVER SIGNALLED. It ran forever. 23 orphaned emulators
    # and a load average of 141 were traced to this, along with two failures
    # that looked like defects elsewhere:
    #
    #   - case 3 printed no verdict. The suite reports from emu.registerexit,
    #     which only runs on a clean shutdown the emulator never got.
    #   - the same run's log stopped at 7 s of internal time, because by then
    #     the machine was carrying 20+ orphans and the emulator was running at
    #     about a seventh of real speed.
    #
    # `pkill -x flycast-dojo` hid this for as long as FLYCAST_BIN was the
    # packaged binary: the name match killed it anyway, so the wrong PID never
    # showed. Point FLYCAST_BIN at build-dojo7/flycast - the normal thing to do -
    # and the mask comes off. A cleanup that works by name is not a backstop for
    # a broken handle; it is what stops you finding out the handle is broken.
    env -C / XDG_CONFIG_HOME="$xdg" XDG_DATA_HOME="$xdg/data" \
        HOME="$xdg/home" DISPLAY=":$DISPLAY_NUM" \
        stdbuf -oL "$BIN" "$ROM" >"$log" 2>&1 &
    local pid=$!
    printf '%s\n' "$pid" >"$WORK/pid"

    # WAIT FOR THE WORK, NOT FOR A DURATION, when the script can say it is done.
    #
    # `[MEASURED 2026-09-14]` case 5 records frames 900-1200 and was given
    # BOOT_SECONDS+14 = 36 s. This machine reaches frame 1200 at about 52 s, so
    # the emulator was killed around frame 800 - before recording even STARTED -
    # and the case reported "no capture file was written", which is true and
    # says nothing about capture.
    #
    # Raising 36 to 70 is the wrong fix: it is a number about this machine, and
    # CLAUDE.md records three separate wrong readings from measuring whatever
    # the sandbox happened to do and stating it as the behaviour. A script that
    # writes a marker when it is finished turns the wait into a fact about the
    # WORK. The duration becomes a ceiling rather than the mechanism, and
    # "never ran" stops being indistinguishable from "ran and produced nothing".
    if [ -n "$marker" ]; then
        local waited=0
        while [ ! -e "$marker" ] && [ "$waited" -lt "$seconds" ]; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
            waited=$((waited + 1))
        done
        [ -e "$marker" ] && sleep 2   # let the stop path finish its work
    else
        sleep "$seconds"
    fi
    kill -TERM "$pid" 2>/dev/null
    # WAIT FOR IT TO ACTUALLY GO. The exit report is written from the
    # Terminate handler, so reading the log immediately after sending the
    # signal races the thing being tested: the first run of this harness
    # reported "the suite never reported" against a log that said CONFORMS.
    #
    # BY PID, NEVER `pkill -x flycast-dojo`. A name-matching kill here reaches
    # the developer's own running emulator, which is the same defect as killing
    # i3 or Xvfb by name (docs/rolltest, dc053dfeb) one binary along. It was
    # also simply wrong: FLYCAST_BIN is usually build-dojo7/flycast, so the
    # name it matched was not even the process this function started.
    local i
    for i in $(seq 1 40); do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.5
    done
    kill -KILL "$pid" 2>/dev/null
    sleep 1
    return 0
}

# WAIT FOR A FILE THAT ANOTHER PROCESS IS STILL WRITING.
#
# `[MEASURED 2026-09-14]` case 5 reported "no capture file was written" against
# a run that produced a perfectly good 11.7 MB AVI. The emulator does not write
# that file: `core/rend/video_recorder.cpp` pipes frames to an EXTERNAL ffmpeg
# through popen (REC_POPEN), so ffmpeg outlives the emulator and finalises the
# container after the process the harness waited for is already gone.
#
# This is the same race run_emulator's own comment describes for the log - "the
# exit report is written from the Terminate handler, so reading the log
# immediately after sending the signal races the thing being tested" - one
# process further out. Waiting for the emulator is not waiting for the work.
#
# Size-stability rather than pgrep ffmpeg: a name match would catch the
# developer's own unrelated encode, which is the mistake this file just removed
# in two other places.
wait_for_stable_file() {
    local f="$1" tries="${2:-60}" last=-1 now i stable=0
    for i in $(seq 1 "$tries"); do
        now="$(stat -c %s "$f" 2>/dev/null || echo 0)"
        if [ "$now" -gt 0 ] && [ "$now" -eq "$last" ]; then
            stable=$((stable + 1))
            [ "$stable" -ge 3 ] && return 0
        else
            stable=0
        fi
        last="$now"
        sleep 0.5
    done
    [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 0 ]
}

# --- case 1: the package runs with no emulator -----------------------------
case_mock() {
    local name="mock conformance (no emulator)"
    command -v lua >/dev/null || { skip "$name" "lua is not installed"; return; }
    [ -r "$PKG/run-conformance.lua" ] || { skip "$name" "no $PKG/run-conformance.lua"; return; }
    local out; out="$(cd "$ROOT" && lua "$PKG/run-conformance.lua" 2>&1)"
    local line; line="$(printf '%s' "$out" | grep -E '^pass=' | tail -1)"
    if printf '%s' "$out" | grep -q '^RESULT: CONFORMS'; then
        # Non-vacuity: a suite that ran no checks also prints no failures.
        local n; n="$(printf '%s' "$line" | sed -n 's/^pass=\([0-9]*\).*/\1/p')"
        if [ "${n:-0}" -gt 50 ]; then ok "$name ($line)"
        else bad "$name" "only ${n:-0} checks ran; expected the whole suite"; fi
    else
        bad "$name" "${line:-no verdict printed}"
    fi
}

# --- case 2: the package does not depend on its directory name -------------
# The bug this reproduces shipped and was found by cloning, not by testing.
case_dirname() {
    local name="package runs from a wrongly-named directory"
    command -v lua >/dev/null || { skip "$name" "lua is not installed"; return; }
    local d="$WORK/definitely-not-called-emuapi"
    cp -r "$PKG" "$d" || { bad "$name" "could not copy the package"; return; }
    local out; out="$(cd "$d" && lua run-conformance.lua 2>&1)"
    if printf '%s' "$out" | grep -q '^RESULT: CONFORMS'; then ok "$name"
    else bad "$name" "$(printf '%s' "$out" | tail -1)"; fi
}

# --- case 3: conformance inside the emulator -------------------------------
case_emulator_conformance() {
    local name="conformance inside the emulator"
    [ -x "$BIN" ] || { skip "$name" "no emulator at $BIN"; return; }
    [ -n "$ROM" ] || { skip "$name" "no ROM; set FLYCAST_ROM"; return; }
    start_x || { skip "$name" "could not start Xvfb"; return; }
    local root="$WORK/conf/flycast-dojo"; mkdir -p "$root"
    cp -r "$PKG" "$root/emuapi"
    printf 'require("emuapi.conformance")\n' >"$root/flycast.lua"
    # GIVE IT A WHOLE SESSION. The suite reports from emu.registerexit - its
    # own comment says "Reported at exit so the rollback sampling has a whole
    # session to observe" - so the verdict appears only after a clean shutdown
    # of a run that got far enough to have something to say.
    #
    # `[MEASURED 2026-09-14]` BOOT_SECONDS+4 = 26 s produced no verdict at all,
    # and the case had been reporting "the suite never reported" as though the
    # suite were broken. At 40 s the same binary and the same script print
    # "RESULT: CONFORMS" with pass=359 fail=0 skip=59. Nothing was wrong with
    # the suite; the harness was killing it too early and blaming it.
    #
    # This IS a number about this machine, which CLAUDE.md warns about, so it is
    # a generous ceiling rather than a tuned value and the failure message below
    # now names the possibility instead of asserting a defect in the suite.
    run_emulator "$root" "$((BOOT_SECONDS + 30))" "$WORK/conf.log"
    local line; line="$(grep -aE '^pass=' "$WORK/conf.log" | tail -1)"
    if grep -aq '^RESULT: CONFORMS' "$WORK/conf.log"; then ok "$name ($line)"
    elif [ -z "$line" ]; then
        bad "$name" "no verdict - the suite reports at exit, so either it did not run long enough (raise FLYCAST_BOOT_SECONDS) or shutdown did not complete"
    else bad "$name" "$line"; fi
}

# --- case 4: a script loads when nothing sets the working directory ---------
case_script_loads() {
    local name="script loads with an unrelated working directory"
    [ -x "$BIN" ] || { skip "$name" "no emulator at $BIN"; return; }
    [ -n "$ROM" ] || { skip "$name" "no ROM; set FLYCAST_ROM"; return; }
    start_x || { skip "$name" "could not start Xvfb"; return; }
    local root="$WORK/tour/flycast-dojo"; mkdir -p "$root"
    cp -r "$PKG" "$root/emuapi"
    printf 'require("emuapi.examples.tour")\n' >"$root/flycast.lua"
    run_emulator "$root" "$BOOT_SECONDS" "$WORK/tour.log"
    local lualog="$root/flycast-lua.log"
    if [ ! -r "$lualog" ]; then
        bad "$name" "no flycast-lua.log was written"
    elif grep -q '^!' "$lualog"; then
        bad "$name" "$(grep '^!' "$lualog" | head -1)"
    elif grep -q 'loaded ' "$lualog"; then
        ok "$name"
    else
        bad "$name" "log exists but records no load: $(tail -1 "$lualog")"
    fi
}

# --- case 5: captured video has pictures in it -----------------------------
# The one that matters most, and the one a structural check cannot make.
case_capture() {
    local name="captured video is not blank"
    [ -x "$BIN" ] || { skip "$name" "no emulator at $BIN"; return; }
    [ -n "$ROM" ] || { skip "$name" "no ROM; set FLYCAST_ROM"; return; }
    command -v ffprobe >/dev/null && command -v ffmpeg >/dev/null \
        || { skip "$name" "ffmpeg/ffprobe not installed"; return; }
    start_x || { skip "$name" "could not start Xvfb"; return; }

    local root="$WORK/rec/flycast-dojo"; mkdir -p "$root"
    local out="$root/capture.avi"
    cat >"$root/flycast.lua" <<LUA
-- Record a fixed span, then stop, so the file is finalised before we look.
local started, stopped, n = false, false, 0
flycast_callbacks = flycast_callbacks or {}
flycast_callbacks.vblank = function()
    n = n + 1
    -- START WELL AFTER BOOT. Recording from frame 60 captured 3 packets and
    -- stopped: the resolution changes as REIOS hands over to the game, and a
    -- resize ends a capture cleanly rather than corrupting it (TODOS.md, "[F]
    -- Survive window resize instead of stopping"). Beginning at frame 900 puts
    -- the span entirely inside the game.
    if n == 900 and not started then
        started = true
        flycast.video.startRecording("$out")
    elseif n == 1200 and not stopped then
        stopped = true
        flycast.video.stopRecording()
        -- SAY SO. The harness waits for this file rather than for a number of
        -- seconds; without it, "the emulator was killed before frame 900" and
        -- "the capture came out empty" produce identical evidence.
        local fh = io.open("$root/recording-stopped", "w")
        if fh then fh:write("stopped at frame " .. n .. "\n"); fh:close() end
    end
end
LUA
    run_emulator "$root" 180 "$WORK/rec.log" "$root/recording-stopped"

    # NON-VACUITY FIRST: did the thing under test actually happen? A missing
    # capture file is equally consistent with "recording never started", which
    # is a fact about the harness rather than about capture.
    if [ ! -e "$root/recording-stopped" ]; then
        bad "$name" "recording never reached its stop; the emulator did not get far enough to test capture"
        return
    fi
    # The emulator is gone, but ffmpeg may not be. See wait_for_stable_file.
    wait_for_stable_file "$out" 60
    if [ ! -s "$out" ]; then bad "$name" "recording stopped but no capture file was written"; return; fi

    local frames; frames="$(ffprobe -v error -select_streams v:0 \
        -count_packets -show_entries stream=nb_read_packets \
        -of csv=p=0 "$out" 2>/dev/null)"
    if [ -z "$frames" ] || [ "$frames" -lt 60 ]; then
        bad "$name" "only ${frames:-0} video packets; expected the recorded span"
        return
    fi

    # THE CHECK THAT ACTUALLY MATTERS: decode pictures and measure them.
    #
    # The first version of this parsed YSTDEV out of ffmpeg's signalstats. That
    # key does not exist - the filter emits YMIN/YLOW/YAVG/YHIGH/YMAX and no
    # standard deviation - so the grep matched nothing, the value defaulted to
    # zero, and a perfectly good 3.3 MB capture was reported as blank. A check
    # that fails when the thing works is worse than no check, so this decodes
    # frames to PNG and asks ImageMagick, where an empty result is an error
    # rather than a zero.
    if ! command -v convert >/dev/null; then
        skip "$name" "ImageMagick is not installed"
        return
    fi
    local shots="$WORK/shots"; mkdir -p "$shots"
    ffmpeg -v error -i "$out" -vf "select='not(mod(n\,20))'" -vsync 0 \
        "$shots/f%03d.png" >/dev/null 2>&1
    local n_shots; n_shots="$(find "$shots" -name 'f*.png' | wc -l)"
    if [ "$n_shots" -eq 0 ]; then
        bad "$name" "the file has $frames packets but no frame could be decoded"
        return
    fi
    local best=0 dev f
    for f in "$shots"/f*.png; do
        dev="$(convert "$f" -colorspace Gray -format "%[fx:standard_deviation*255]" info: 2>/dev/null)"
        [ -n "$dev" ] || continue
        awk -v a="$dev" -v b="$best" 'BEGIN{exit !(a>b)}' && best="$dev"
    done
    # A black, white or single-colour frame has a standard deviation of zero
    # and satisfies every structural check above this one. That exact file -
    # correct dimensions, frame count, duration and container, entirely black -
    # is why this case exists.
    if awk -v d="$best" 'BEGIN{exit !(d > 3.0)}'; then
        ok "$name ($frames packets, $n_shots frames decoded, peak stddev ${best})"
    else
        bad "$name" "decoded $n_shots frames and the most varied has stddev ${best}; the picture is blank"
    fi
}

usage() {
    cat <<EOF
cases (name any of them as arguments to run just those):
  mock        conformance with no emulator
  dirname     package runs from a wrongly-named directory
  conformance conformance inside the emulator
  script      a script loads with an unrelated working directory
  capture     captured video is not blank
EOF
}

# NAMING CASES. `--list` has always printed the five names and there was no way
# to RUN one, so diagnosing a single failing case meant re-running all five -
# about four minutes for one 30-second question. The names it prints are now
# accepted as arguments.
FAST=0
declare -a want=()
for a in "$@"; do
    case "$a" in
        --fast) FAST=1 ;;
        --list) usage; exit 0 ;;
        -h|--help) sed -n '2,30p' "$SELF"; exit 0 ;;
        -*) printf 'unknown option: %s\n' "$a" >&2; exit 1 ;;
        mock|dirname|conformance|script|capture) want+=("$a") ;;
        *) printf 'unknown case: %s (see --list)\n' "$a" >&2; exit 1 ;;
    esac
done

# A named case runs whether or not it is one of the slow ones; --fast is only
# meaningful when selecting the default set.
selected() {
    [ ${#want[@]} -eq 0 ] && return 0
    local w; for w in "${want[@]}"; do [ "$w" = "$1" ] && return 0; done
    return 1
}

ROM="$(find_rom)"
printf 'flycast-dojo integration tests\n'
printf '  binary: %s\n' "$BIN"
printf '  rom:    %s\n' "${ROM:-<none>}"
printf '  work:   %s\n\n' "$WORK"

selected mock    && case_mock
selected dirname && case_dirname
if [ "$FAST" -eq 0 ] || [ ${#want[@]} -gt 0 ]; then
    selected conformance && case_emulator_conformance
    selected script      && case_script_loads
    selected capture     && case_capture
else
    skip "emulator cases" "--fast was given"
fi

# A run that selected nothing is vacuous and must not report success.
if [ $((pass + fail + skipped)) -eq 0 ]; then
    printf 'no cases ran\n' >&2
    exit 2
fi

printf '\npass=%d fail=%d skip=%d\n' "$pass" "$fail" "$skipped"
if [ "$fail" -gt 0 ]; then
    printf 'FAILED:\n'
    for f in "${failures[@]}"; do printf '  %s\n' "$f"; done
    exit 1
fi
# A skip is not a pass. Exiting 0 here would let a machine with no ROM report
# success for cases that never ran.
[ "$skipped" -gt 0 ] && { printf 'incomplete: %d case(s) skipped\n' "$skipped"; exit 2; }
printf 'all cases passed\n'
exit 0
