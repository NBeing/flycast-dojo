[Desktop Entry]
Type=Application
Name=Flycast Dojo
Comment=Pick a game and how to run it
Exec=flycast-rofi
Icon=applications-games
Terminal=false
Categories=Game;Emulator;
Actions=Play;Record;Conformance;

[Desktop Action Play]
Name=Play (default game)
Exec=flycast-rofi --play

[Desktop Action Record]
Name=Play and record video
Exec=flycast-rofi --record

[Desktop Action Conformance]
Name=Run the Lua conformance suite
Exec=flycast-rofi --conformance
